<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://rag-trilogy.org/ontology">

  <!--
    Stub OWL ontology for Phase 3 — Ontology RAG.
    Expand with domain-specific classes and properties as needed.
  -->

  <owl:Ontology rdf:about="http://rag-trilogy.org/ontology"/>

  <!-- ── Core Classes ─────────────────────────────────────── -->

  <owl:Class rdf:ID="Entity">
    <rdfs:label>Entity</rdfs:label>
    <rdfs:comment>Base class for all named entities in the knowledge graph.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:ID="Person">
    <rdfs:subClassOf rdf:resource="#Entity"/>
    <rdfs:label>Person</rdfs:label>
  </owl:Class>

  <owl:Class rdf:ID="Organization">
    <rdfs:subClassOf rdf:resource="#Entity"/>
    <rdfs:label>Organization</rdfs:label>
  </owl:Class>

  <owl:Class rdf:ID="Location">
    <rdfs:subClassOf rdf:resource="#Entity"/>
    <rdfs:label>Location</rdfs:label>
  </owl:Class>

  <owl:Class rdf:ID="Event">
    <rdfs:subClassOf rdf:resource="#Entity"/>
    <rdfs:label>Event</rdfs:label>
  </owl:Class>

  <!-- ── Object Properties (Relationships) ───────────────── -->

  <owl:ObjectProperty rdf:ID="worksFor">
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="#Organization"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="locatedIn">
    <rdfs:domain rdf:resource="#Entity"/>
    <rdfs:range rdf:resource="#Location"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="relatedTo">
    <rdfs:domain rdf:resource="#Entity"/>
    <rdfs:range rdf:resource="#Entity"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="partOf">
    <rdfs:domain rdf:resource="#Entity"/>
    <rdfs:range rdf:resource="#Entity"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:ID="participatedIn">
    <rdfs:domain rdf:resource="#Person"/>
    <rdfs:range rdf:resource="#Event"/>
  </owl:ObjectProperty>

</rdf:RDF>
