# MetaQA dataset + generated docs are local; the frozen eval/manifest and the
# checksum files ARE tracked (small, and required to reproduce a run).
/MetaQA/*
!/MetaQA/FROZEN*.sha256
!/MetaQA/metaqa_eval_v1.jsonl
!/MetaQA/metaqa_eval_mini.jsonl
!/MetaQA/metaqa_eval_mini30.jsonl
!/MetaQA/corpus_manifest.txt
!/MetaQA/corpus_manifest_mini.txt
!/MetaQA/corpus_manifest_mini30.txt

