# ── Required ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# Optional OpenRouter route. Prefix the model with openrouter/.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# ── Dataset selection (hotpot | metaqa | metaqa_mini | metaqa_mini30 | local) ──
# DATASET=hotpot is the default and reproduces the historical paths/results.
# DATASET=metaqa switches to the frozen MetaQA corpus (see README -> MetaQA Track).
# DATASET=metaqa_mini is the 12q/50-doc wiring slice; metaqa_mini30 is the
# 30q/100-doc plumbing corpus (scripts.metaqa_make_mini30).
# DATASET=local reads LOCAL_DOCS_DIR + LOCAL_EVAL_FILE (any TXT/PDF/MD corpus).
# DATASET=metaqa
# Retrieval depth: TOP_K overrides the per-phase defaults (hotpot: 8/5;
# MetaQA tracks: 20 for both phases; local: 8).
# TOP_K=20

# ── LLM Models (optional overrides) ──────────────────────────
# Luna models accept ONLY the provider-default temperature (1): do not set a
# temperature variable, the code omits the parameter and records "default".
GENERATION_MODEL=gpt-6-luna
# For a temperature-capable model (for example OpenRouter Qwen):
# GENERATION_TEMPERATURE=0
# GENERATION_REASONING_EFFORT=none
JUDGE_MODEL=gpt-5.6-luna      # must differ from the generator; fixed parser + raw verdict
EXTRACTION_MODEL=gpt-6-luna   # Phase 2/3b; litellm wrapper, no temperature, no max_tokens
# RAGAS injects temperature=1e-8 (unsupported by Luna); keep it on its own model.
# Answer Correctness is not reported (it scored ~0.24 on exact answers).
RAGAS_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── RAG Retrieval defaults (optional overrides) ──────────────
# DEFAULT_TOP_K=8
# DEFAULT_SIMILARITY_THRESHOLD=0.3
# CHUNK_SIZE_HOTPOT=200
# CHUNK_OVERLAP_HOTPOT=20
# CHUNK_SIZE_PDF=512
# CHUNK_OVERLAP_PDF=64
# CHUNK_SIZE_GRAPH=256
# CHUNK_OVERLAP_GRAPH=20

# ── Qdrant (Phase 1 vector store) ────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=rag_phase_1_baseline

# ── Neo4j (Phase 2 graph store) ──────────────────────────────
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=hotpot-graph

# ── Neo4j for MetaQA (must never be the HotpotQA database) ───
# Default: same server, dedicated database. If your server is single-database
# (Community), start the isolated service instead:
#   docker compose up -d neo4j-metaqa
#   NEO4J_METAQA_URI=neo4j://127.0.0.1:7688
#   NEO4J_METAQA_DATABASE=neo4j
# NEO4J_METAQA_URI=neo4j://127.0.0.1:7687
# NEO4J_METAQA_DATABASE=metaqa-graph

# ── MetaQA artifacts (frozen; override only to rebuild the track) ─
# METAQA_EVAL_FILE=MetaQA/metaqa_eval_v1.jsonl
# METAQA_DOC_LIST=MetaQA/corpus_manifest.txt
# METAQA_DOCS_DIR=MetaQA/docs
# METAQA_CHUNK_SIZE=256
# METAQA_CHUNK_OVERLAP=32

# ── MetaQA mini track (hop-balanced slice, `python -m scripts.metaqa_make_mini`) ─
# DATASET=metaqa_mini uses these plus its own graph database and results dir.
# METAQA_MINI_EVAL_FILE=MetaQA/metaqa_eval_mini.jsonl
# METAQA_MINI_DOC_LIST=MetaQA/corpus_manifest_mini.txt
# NEO4J_METAQA_MINI_DATABASE=metaqa-mini-graph

# ── MetaQA mini30 track (30 questions / 100 docs, `make mini30`) ──────────────
# Additive: the 12/50 mini above stays frozen and runnable.
# METAQA_MINI30_EVAL_FILE=MetaQA/metaqa_eval_mini30.jsonl
# METAQA_MINI30_DOC_LIST=MetaQA/corpus_manifest_mini30.txt
# NEO4J_METAQA_MINI30_DATABASE=metaqa-mini30-graph

# ── Phase 3 (ontology) graph databases (never the Phase 2 database) ──────────
# NEO4J_PHASE3_DATABASE=hotpot-ontology-graph
# NEO4J_METAQA_PHASE3_DATABASE=metaqa-ontology-graph
# NEO4J_METAQA_MINI_PHASE3_DATABASE=metaqa-mini-ontology-graph
# NEO4J_PHASE3B_DATABASE=hotpot-ontology-b-graph
# NEO4J_METAQA_PHASE3B_DATABASE=metaqa-ontology-b-graph
# NEO4J_METAQA_MINI_PHASE3B_DATABASE=metaqa-mini-ontology-b-graph
# NEO4J_METAQA_MINI30_PHASE3_DATABASE=metaqa-mini30-ontology-graph
# NEO4J_METAQA_MINI30_PHASE3B_DATABASE=metaqa-mini30-ontology-b-graph

# ── Generic local track (DATASET=local) ───────────────────────────────────────
# LOCAL_DOCS_DIR=data_finance
# LOCAL_EVAL_FILE=path/to/eval.jsonl   # question/answer (+ optional answers)
# LOCAL_PATTERN=**/*.pdf               # any glob SimpleDirectoryReader can read
# LOCAL_COLLECTION=rag_local
# LOCAL_NEO4J_DATABASE=local-graph
# LOCAL_NEO4J_PHASE3_DATABASE=local-ontology-graph
# LOCAL_CHUNK_SIZE=256
# LOCAL_CHUNK_OVERLAP=32

# ── Phase 2 ablation (recorded in run_meta) ──────────────────────────────────
# INCLUDE_NEIGHBOURS=1                 # 0 = no-neighbours ablation (MetaQA)
# RESULTS_TAG=_no_neighbours           # write results/<dataset>/phaseN_<tag>/

# ── Maritaca (optional LLM fallback) ─────────────────────────
# MARITACA_API_KEY=
# MARITACA_API_BASE=

# ── Wikipedia (MetaQA corpus fetch) ──────────────────────────
# Contact address for the Wikimedia User-Agent. Required by
# `python -m scripts.metaqa_fetch_wiki` (public API policy).
WIKI_CONTACT=you@example.com
