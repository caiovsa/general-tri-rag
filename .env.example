# ── Required ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── Dataset selection (hotpot | metaqa | metaqa_mini) ────────
# DATASET=hotpot is the default and reproduces the historical paths/results.
# DATASET=metaqa switches to the frozen MetaQA corpus (see README -> MetaQA Track).
# DATASET=metaqa
# Retrieval depth: overrides the per-phase default (phase 1 -> 8, phase 2 -> 5)
# TOP_K=8

# ── LLM Models (optional overrides) ──────────────────────────
GENERATION_MODEL=gpt-4o-mini
# JUDGE_MODEL=gpt-4o-mini   # defaults to GENERATION_MODEL; MetaQA judge runs at temperature 0
EXTRACTION_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ── RAG Retrieval defaults (optional overrides) ──────────────
# DEFAULT_TOP_K=8
# DEFAULT_SIMILARITY_THRESHOLD=0.3
# CHUNK_SIZE_HOTPOT=200
# CHUNK_OVERLAP_HOTPOT=20
# CHUNK_SIZE_PDF=512
# CHUNK_OVERLAP_PDF=64
# CHUNK_SIZE_GRAPH=256
# CHUNK_OVERLAP_GRAPH=20

# ── Qdrant (Phase 1 vector store) ────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=rag_phase_1_baseline

# ── Neo4j (Phase 2 graph store) ──────────────────────────────
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=hotpot-graph

# ── Neo4j for MetaQA (must never be the HotpotQA database) ───
# Default: same server, dedicated database. If your server is single-database
# (Community), start the isolated service instead:
#   docker compose up -d neo4j-metaqa
#   NEO4J_METAQA_URI=neo4j://127.0.0.1:7688
#   NEO4J_METAQA_DATABASE=neo4j
# NEO4J_METAQA_URI=neo4j://127.0.0.1:7687
# NEO4J_METAQA_DATABASE=metaqa-graph

# ── MetaQA artifacts (frozen; override only to rebuild the track) ─
# METAQA_EVAL_FILE=MetaQA/metaqa_eval_v1.jsonl
# METAQA_DOC_LIST=MetaQA/corpus_manifest.txt
# METAQA_DOCS_DIR=MetaQA/docs
# METAQA_CHUNK_SIZE=256
# METAQA_CHUNK_OVERLAP=32

# ── MetaQA mini track (hop-balanced slice, `python -m scripts.metaqa_make_mini`) ─
# DATASET=metaqa_mini uses these plus its own graph database and results dir.
# METAQA_MINI_EVAL_FILE=MetaQA/metaqa_eval_mini.jsonl
# METAQA_MINI_DOC_LIST=MetaQA/corpus_manifest_mini.txt
# NEO4J_METAQA_MINI_DATABASE=metaqa-mini-graph

# ── Maritaca (optional LLM fallback) ─────────────────────────
# MARITACA_API_KEY=
# MARITACA_API_BASE=

# ── Wikipedia (MetaQA corpus fetch) ──────────────────────────
# Contact address for the Wikimedia User-Agent. Required by
# `python -m scripts.metaqa_fetch_wiki` (public API policy).
WIKI_CONTACT=you@example.com
